{
  "name": "gi-clinical-studies-wcp",
  "version": "1.0.0",
  "description": "Web Configuration Portal for FDA MyStudies - GI Clinical Studies",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "nodemon backend/server.js",
    "frontend": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "db:init": "node database/init.js",
    "db:seed": "node database/seed.js",
    "start": "node backend/server.js"
  },
  "keywords": [
    "FDA",
    "MyStudies",
    "Clinical",
    "GI",
    "Portal"
  ],
  "author": "GI Clinical Studies",
  "license": "Apache-2.0",
  "dependencies": {
    "express": "^4.18.2",
    "express-jwt": "^8.4.1",
    "jsonwebtoken": "^9.1.0",
    "pg": "^8.9.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "joi": "^17.10.0",
    "uuid": "^9.0.0",
    "express-validator": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  }
}
